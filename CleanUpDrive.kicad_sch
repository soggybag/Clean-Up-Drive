	(text "INPUT BUFFER (U1A): clean signal for the drive \nstage and the detector"
		(exclude_from_sim no)
		(at 105.41 25.4 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "11ba4acf-2287-4fc2-a78c-1585449eced8")
	)
	(text "LDR_B goes to VB. Off-board: the pots and switch; everything else fits a breadboard."
		(exclude_from_sim no)
		(at 107.95 204.47 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "12ceb99e-092f-46f3-8c46-5f45ce56d2f4")
	)
	(text "DRIVE sets the resting gain (x2 to x101). Picking harder lights the LDR, which pulls the \nground leg down through DEPTH:"
		(exclude_from_sim no)
		(at 107.95 189.23 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2e1e0ab8-6a68-4f30-b437-dfd3e5a6f520")
	)
	(text "LDR_A goes to the DEPTH leg of the drive stage, LDR_B (pin 3) to VB."
		(exclude_from_sim no)
		(at 227.33 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "43b48511-477e-4b2d-a395-ba2a80c57204")
	)
	(text "OUTPUT: TONE (hi-cut) + VOLUME"
		(exclude_from_sim no)
		(at 220.98 180.34 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "593fb5d6-7659-4d6a-b91b-d5139ea1eb74")
	)
	(text "more gain, more clipping. The diodes hold the output at about +-0.6 V \n(Si) / +-1.8 V (LED), so U1B never clips."
		(exclude_from_sim no)
		(at 107.95 196.85 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6fa0b7f2-bdab-4421-a1ff-9df280514740")
	)
	(text "POWER + BIAS + JACKS"
		(exclude_from_sim no)
		(at 11.43 19.05 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "98628779-26fd-4d1a-a69c-2c89cce377af")
	)
	(text "DRIVE STAGE (U1B): gain = 1 + R5 / ((R6 + DRIVE) || (R7 + \nDEPTH + LDR)); diodes cap the output"
		(exclude_from_sim no)
		(at 105.41 88.9 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "aa6b5797-9b69-4048-9b7c-0a0ba06a13a9")
	)
	(text "SENSE: how hard you must pick to light the LDR. U2A gain 10, U2B unity inverter: bridge sees 0-20x DRY."
		(exclude_from_sim no)
		(at 227.33 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b23db8b1-f252-444e-b840-99e7045d8e89")
	)
	(text "DETECTOR (U2): fed from the CLEAN signal through SENSE; full-wave bridge into the vactrol LED"
		(exclude_from_sim no)
		(at 220.98 19.05 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "e3cc664f-2afb-45b3-943e-6bac2b537274")
	)
